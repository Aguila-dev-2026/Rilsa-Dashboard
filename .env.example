# El modo local es el predeterminado y no necesita estas variables.
RILSA_APP_ENV=cloud
DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/rilsa?sslmode=require

# Credenciales de una App Registration de Microsoft Entra ID.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Biblioteca de documentos y archivos autorizados de SharePoint.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FISICO_ITEM_ID=
SHAREPOINT_AEROBICO_ITEM_ID=

# Desactivado por defecto para que sólo un proceso autorizado sincronice.
RILSA_ENABLE_MANUAL_SYNC=false
